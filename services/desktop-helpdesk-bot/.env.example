# Rocket.Chat (tarayici oturumu — token gerekmez)
ROCKETCHAT_URL=https://rocket.dmc-rz.com
ROCKETCHAT_CHANNEL=IT_Helpdesk

# Chrome remote debugging — start-chrome.ps1 ile acilir
CDP_URL=http://127.0.0.1:9222

# Bot kullanicisinin Rocket.Chat'teki gorunen adi (kendi mesajlarini yok sayar)
BOT_DISPLAY_NAME=IT Bot

# Mesaj tarama araligi (saniye)
POLL_INTERVAL_SEC=8

# Sadece ses/kulaklik anahtar kelimeli talepleri otomatik isle (true/false)
AUDIO_KEYWORDS_ONLY=true

# AnyDesk
ANYDESK_EXE=C:\Program Files (x86)\AnyDesk\AnyDesk.exe
ANYDESK_CONNECT_TIMEOUT_SEC=120
# Opsiyonel: unattended erisim sifresi (yoksa personel AnyDesk'te kabul etmeli)
# ANYDESK_PASSWORD=

# Uzak PC'de calistirilacak kulaklik onarim scripti (raw GitHub veya Vercel URL)
HEADSET_REPAIR_PS1_URL=https://raw.githubusercontent.com/OWNER/ithelpdesk/main/tools/headset-repair/HeadsetRepair.ps1

# Uzak oturumda onarim komutu calistirildiktan sonra bekleme (saniye)
REMOTE_REPAIR_WAIT_SEC=90

# Rocket.Chat DOM secicileri (surum degisirse .env'den guncelle)
RC_MESSAGE_SELECTOR=[data-qa="message"], .rcx-message
RC_MESSAGE_BODY_SELECTOR=[data-qa="message-body"], .rcx-message-body, .message-body
RC_MESSAGE_USER_SELECTOR=[data-qa="message-header"], .rcx-message-header__username
RC_INPUT_SELECTOR=[data-qa="message-input"], textarea.rcx-message-box__input, .rcx-message-box textarea
RC_SEND_SELECTOR=[data-qa="send"], button[aria-label*="Send"], button[aria-label*="Gonder"]
